+    /// Whether the open Lichess game has no moves yet (abortable).
+    pub fn active_lichess_game_has_no_moves(&self) -> bool {
+        self.game.logic.game_board.move_history.is_empty()
+            && self
+                .game
+                .logic
+                .opponent
+                .as_ref()
+                .map(|o| o.initial_move_count == 0 && o.moves_received == 0)
+                .unwrap_or(true)
+    }
+
+    /// Aborts (no moves played) or resigns the game currently open on the board.
+    fn finish_active_lichess_game(&mut self, game_id: String) {
+        let abort = self.active_lichess_game_has_no_moves();
+
+        let Ok(client) = self.lichess_state.require_client() else {
+            self.ui_state.show_message_popup(
+                "Lichess client not properly initialized, did you configure a lichess token ?"
+                    .to_string(),
+                Popups::Error,
+            );
+            return;
+        };
+        let client = client.clone();
+
+        let (tx, rx) = channel();
+        self.lichess_state.receiver = Some(rx);
+        self.ui_state.close_popup();
+
+        std::thread::spawn(move || {
+            let result = if abort {
+                client.abort_game(&game_id)
+            } else {
+                client.resign_game(&game_id)
+            };
+            let message = match result {
+                Ok(()) => Ok(if abort {
+                    "Game aborted (no moves played).".to_string()
+                } else {
+                    "Game resigned.".to_string()
+                }),
+                Err(e) => Err(format!(
+                    "Failed to {} the game: {}",
+                    if abort { "abort" } else { "resign" },
+                    e
+                )),
+            };
+            let _ = tx.send(LichessUpdate::GameActionResult(message));
+        });
+    }
