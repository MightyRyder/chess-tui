+    /// Create a casual open challenge with the given clock. A limit of 0
+    /// creates a correspondence challenge (3 days per move). The returned
+    /// challenge can be shared with an opponent; it becomes a game once
+    /// accepted, keeping the same id.
+    pub fn create_open_challenge(
+        &self,
+        limit_seconds: u32,
+        increment_seconds: u32,
+    ) -> Result<OpenChallenge, Box<dyn Error>> {
+        let url = format!("{}/challenge/open", LICHESS_API_URL);
+
+        let mut form: Vec<(&str, String)> = vec![
+            ("rated", "false".to_string()),
+            ("variant", "standard".to_string()),
+        ];
+        if limit_seconds == 0 {
+            form.push(("days", "3".to_string()));
+        } else {
+            form.push(("clock.limit", limit_seconds.to_string()));
+            form.push(("clock.increment", increment_seconds.to_string()));
+        }
+
+        let response = self
+            .client
+            .post(&url)
+            .header(
+                "User-Agent",
+                "chess-tui (https://github.com/thomas-mauran/chess-tui)",
+            )
+            .bearer_auth(&self.token)
+            .form(&form)
+            .send()?;
+
+        let status = response.status();
+        if !status.is_success() {
+            let error_text = response.text().unwrap_or_default();
+            log::error!("Open challenge request failed: {} - {}", status, error_text);
+            if status == reqwest::StatusCode::UNAUTHORIZED {
+                return Err("Invalid token. Please check your token or generate a new one.".into());
+            }
+            if status == reqwest::StatusCode::FORBIDDEN {
+                return Err("Token missing permissions. Please generate a new token with 'board:play' scope enabled.".into());
+            }
+            if status == reqwest::StatusCode::TOO_MANY_REQUESTS {
+                return Err(
+                    "Rate limit exceeded. Please wait a minute before trying again.".into(),
+                );
+            }
+            if status == reqwest::StatusCode::BAD_REQUEST {
+                return Err(format!(
+                    "Lichess rejected the challenge parameters: {}",
+                    error_text
+                )
+                .into());
+            }
+            return Err(format!("Failed to create challenge: {} - {}", status, error_text).into());
+        }
+
+        let challenge: OpenChallenge = response.json()?;
+        log::info!(
+            "Created open challenge: {} ({:?})",
+            challenge.id,
+            challenge.url
+        );
+        Ok(challenge)
+    }
+
+    /// Claim a seat in an open challenge so this account becomes one of the
+    /// two players once the game starts. `color` is "white" or "black".
+    pub fn accept_challenge(&self, challenge_id: &str, color: &str) -> Result<(), Box<dyn Error>> {
+        let url = format!(
+            "{}/challenge/{}/accept?color={}",
+            LICHESS_API_URL, challenge_id, color
+        );
+        let response = self
+            .client
+            .post(&url)
+            .header(
+                "User-Agent",
+                "chess-tui (https://github.com/thomas-mauran/chess-tui)",
+            )
+            .bearer_auth(&self.token)
+            .send()?;
+
+        let status = response.status();
+        if !status.is_success() {
+            let error_text = response.text().unwrap_or_default();
+            log::error!("Challenge accept failed: {} - {}", status, error_text);
+            return Err(format!("{} - {}", status, error_text).into());
+        }
+
+        log::info!("Claimed a seat in challenge {}", challenge_id);
+        Ok(())
+    }
+
+    /// Withdraw an open challenge that has not been accepted yet.
+    pub fn cancel_challenge(&self, challenge_id: &str) -> Result<(), Box<dyn Error>> {
+        let url = format!("{}/challenge/{}/cancel", LICHESS_API_URL, challenge_id);
+        let response = self
+            .client
+            .post(&url)
+            .header(
+                "User-Agent",
+                "chess-tui (https://github.com/thomas-mauran/chess-tui)",
+            )
+            .bearer_auth(&self.token)
+            .send()?;
+
+        if response.status().is_success() {
+            log::info!("Cancelled challenge {}", challenge_id);
+        } else {
+            log::warn!(
+                "Failed to cancel challenge {} (status {})",
+                challenge_id,
+                response.status()
+            );
+        }
+        Ok(())
+    }
+
+    /// Block until the open challenge is accepted and the game appears in the
+    /// ongoing games list, returning the game id and our color. Polls every
+    /// 2 seconds for up to 15 minutes; aborts early if `cancellation_token`
+    /// is set.
+    pub fn wait_for_open_challenge_start(
+        &self,
+        challenge_id: &str,
+        cancellation_token: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    ) -> Result<(String, Color), Box<dyn Error>> {
+        const POLL_INTERVAL: std::time::Duration = std::time::Duration::from_secs(2);
+        const MAX_ATTEMPTS: usize = 450; // 15 minutes
+
+        for attempt in 0..MAX_ATTEMPTS {
+            if cancellation_token.load(std::sync::atomic::Ordering::Relaxed) {
+                return Err("Hosting cancelled".into());
+            }
+
+            match self.get_ongoing_games() {
+                Ok(games) => {
+                    if let Some(game) = games.iter().find(|g| g.game_id == challenge_id) {
+                        let color = parse_game_color(&game.color);
+                        log::info!("Hosted game {} started (playing {:?})", challenge_id, color);
+                        return Ok((game.game_id.clone(), color));
+                    }
+                }
+                Err(e) => log::warn!("Failed to poll ongoing games: {}", e),
+            }
+
+            if attempt < MAX_ATTEMPTS - 1 {
+                std::thread::sleep(POLL_INTERVAL);
+            }
+        }
+
+        Err("Timed out waiting for an opponent to join".into())
+    }
 }
