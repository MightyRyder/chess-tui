+        let status = response.status();
+        if !status.is_success() {
+            let body = response.text().unwrap_or_default();
+            log::error!("Failed to {}: {} - {}", action, status, body);
+            return Err(format!(
+                "Failed to {}: {}",
+                action,
+                extract_error_message(&body, status)
+            )
+            .into());
+        }
+
+        log::info!("Lichess action succeeded: {}", action);
+        Ok(())
+    }
