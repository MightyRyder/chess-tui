@@ -0,0 +1,181 @@
+//! Popups for hosting a private Lichess game (open challenge).
+
+use crate::{
+    app::App,
+    constants::{LICHESS_HOST_TIME_CONTROLS, WHITE},
+    ui::components::centered_rect::centered_rect,
+};
+use ratatui::{
+    Frame,
+    layout::Alignment,
+    style::{Color, Modifier, Style},
+    text::{Line, Span},
+    widgets::{Block, BorderType, Borders, Clear, Padding, Paragraph, Wrap},
+};
+
+/// Renders the time-control picker for a hosted Lichess game.
+pub fn render_host_game_popup(frame: &mut Frame, app: &App) {
+    let title = if app.lichess_state.rematch_target.is_some() {
+        "Rematch"
+    } else {
+        "Host a Lichess Game"
+    };
+    let block = Block::default()
+        .title(title)
+        .borders(Borders::ALL)
+        .border_type(BorderType::Rounded)
+        .padding(Padding::horizontal(1))
+        .border_style(Style::default().fg(WHITE));
+    let area = centered_rect(60, 80, frame.area());
+
+    let mut text = match &app.lichess_state.rematch_target {
+        Some(target) => vec![
+            Line::from(format!("Send a rematch challenge to {}.", target))
+                .alignment(Alignment::Center),
+            Line::from("They can accept it on Lichess or in chess-tui.")
+                .alignment(Alignment::Center),
+        ],
+        None => vec![
+            Line::from("Create a private game, then share its code/link.")
+                .alignment(Alignment::Center),
+            Line::from("Your opponent joins with Lichess → Join by Code.")
+                .alignment(Alignment::Center),
+        ],
+    };
+    text.extend(vec![
+        Line::from(""),
+        Line::from("Choose a time control:"),
+        Line::from(""),
+    ]);
+
+    for (idx, (label, _, _)) in LICHESS_HOST_TIME_CONTROLS.iter().enumerate() {
+        let selected = idx as u8 == app.lichess_state.host_game_cursor;
+        let style = if selected {
+            Style::default()
+                .fg(Color::Black)
+                .bg(Color::White)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(Color::White)
+        };
+        let prefix = if selected { "► " } else { "  " };
+        text.push(Line::from(vec![
+            Span::styled(prefix, style),
+            Span::styled(*label, style),
+        ]));
+    }
+
+    text.push(Line::from(""));
+    let mode = if app.lichess_state.host_rated {
+        "Rated"
+    } else {
+        "Casual"
+    };
+    text.push(Line::from(vec![
+        Span::styled("Mode:  ", Style::default().fg(Color::Cyan)),
+        Span::styled(
+            mode,
+            Style::default()
+                .fg(Color::Black)
+                .bg(Color::White)
+                .add_modifier(Modifier::BOLD),
+        ),
+        Span::raw("   (press r to toggle)"),
+    ]));
+
+    let color = match app.lichess_state.host_color {
+        crate::state::lichess_state::HostColor::White => "White",
+        crate::state::lichess_state::HostColor::Black => "Black",
+        crate::state::lichess_state::HostColor::Random => "Random",
+    };
+    text.push(Line::from(vec![
+        Span::styled("Color: ", Style::default().fg(Color::Cyan)),
+        Span::styled(
+            color,
+            Style::default()
+                .fg(Color::Black)
+                .bg(Color::White)
+                .add_modifier(Modifier::BOLD),
+        ),
+        Span::raw("   (press c to cycle)"),
+    ]));
+    text.push(Line::from(""));
+    text.push(Line::from(
+        "↑/↓ Select   r Rated/Casual   c Color   Enter Create   Esc Cancel",
+    ));
+
+    let paragraph = Paragraph::new(text)
+        .block(block.clone())
+        .alignment(Alignment::Left)
+        .wrap(Wrap { trim: true });
+
+    frame.render_widget(Clear, area);
+    frame.render_widget(block, area);
+    frame.render_widget(paragraph, area);
+}
+
+/// Renders the waiting screen that shows the shareable challenge code/link
+/// while the host waits for the opponent to join.
+pub fn render_host_game_waiting_popup(frame: &mut Frame, app: &App) {
+    let block = Block::default()
+        .title("Waiting for Opponent")
+        .borders(Borders::ALL)
+        .border_type(BorderType::Rounded)
+        .padding(Padding::horizontal(1))
+        .border_style(Style::default().fg(WHITE));
+    let area = centered_rect(60, 40, frame.area());
+
+    let mut text: Vec<Line> = Vec::new();
+
+    if let Some((id, url)) = &app.lichess_state.host_challenge {
+        let mode = if app.lichess_state.host_rated {
+            "rated"
+        } else {
+            "casual"
+        };
+        match &app.lichess_state.rematch_target {
+            Some(target) => text.push(Line::from(format!(
+                "Rematch challenge ({}) sent to {}!",
+                mode, target
+            ))),
+            None => text.push(Line::from(format!(
+                "Open challenge created ({})! Share this with your opponent:",
+                mode
+            ))),
+        }
+        text.push(Line::from(""));
+        text.push(Line::from(vec![
+            Span::raw("  Code:  "),
+            Span::styled(
+                id.clone(),
+                Style::default()
+                    .fg(Color::Yellow)
+                    .add_modifier(Modifier::BOLD),
+            ),
+        ]));
+        text.push(Line::from(vec![
+            Span::raw("  Link:  "),
+            Span::styled(url.clone(), Style::default().fg(Color::Cyan)),
+        ]));
+        text.push(Line::from(""));
+        text.push(Line::from(
+            "They join via Lichess → Join by Code (paste code or link).",
+        ));
+        text.push(Line::from(""));
+        text.push(Line::from("The game starts automatically once they join."));
+    } else {
+        text.push(Line::from("Creating challenge on Lichess ..."));
+    }
+
+    text.push(Line::from(""));
+    text.push(Line::from("Press Esc to cancel the challenge.").alignment(Alignment::Center));
+
+    let paragraph = Paragraph::new(text)
+        .block(block.clone())
+        .alignment(Alignment::Left)
+        .wrap(Wrap { trim: true });
+
+    frame.render_widget(Clear, area);
+    frame.render_widget(block, area);
+    frame.render_widget(paragraph, area);
+}
