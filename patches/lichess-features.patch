+    /// Starts a Lichess puzzle without a token: fetches a puzzle at the
+    /// difficulty chosen in the level picker. No rating is tracked.
+    pub fn start_anonymous_puzzle_mode(&mut self) {
+        // Clear any existing popups and error messages when starting a new puzzle
+        self.ui_state.close_popup();
+        self.ui_state.popup_message = None;
+        self.lichess_state.puzzle_game = None;
+
+        // Puzzles don't use a Lichess opponent, so no polling threads needed.
+        self.game.logic.opponent = None;
+        self.game_mode_state.selected_color = None;
+        self.game_mode_state.is_random_color = false;
+
+        // Reset game state to Playing (in case it was Checkmate/Draw from a
+        // previous puzzle).
+        self.game.logic.game_state = GameState::Playing;
+
+        let idx = usize::from(self.lichess_state.puzzle_level_cursor)
+            .min(crate::constants::LICHESS_PUZZLE_DIFFICULTIES.len() - 1);
+        let (_, difficulty) = crate::constants::LICHESS_PUZZLE_DIFFICULTIES[idx];
+
+        // Public puzzle endpoints accept anonymous requests.
+        let client = LichessClient::anonymous();
+        let puzzle =
+            match PuzzleGame::load_anonymous(&client, &mut self.game.logic.game_board, difficulty) {
+                Ok(p) => p,
+                Err(e) => {
+                    self.ui_state.show_message_popup(e, Popups::Error);
+                    return;
+                }
+            };
+
+        self.game.logic.sync_player_turn_with_position();
+
+        self.lichess_state.puzzle_game = Some(PuzzleGame::new(puzzle, None));
+
+        // Ensure board stays unflipped in puzzle mode
+        if self.lichess_state.puzzle_game.is_some() {
+            self.game.logic.game_board.is_flipped = false;
+        }
+        // Switch to Solo page to show the board
+        self.ui_state.current_page = Pages::Solo;
+    }
