+/// Renders the draw options (offer/accept, decline, claim) for the active game.
+pub fn render_draw_menu_popup(frame: &mut Frame, app: &App) {
+    let block = Block::default()
+        .title("Draw")
+        .borders(Borders::ALL)
+        .border_type(BorderType::Rounded)
+        .padding(Padding::horizontal(1))
