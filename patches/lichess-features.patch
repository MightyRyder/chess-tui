+    /// Hosts a private Lichess game: creates a casual open challenge with the
+    /// time control at `host_game_cursor`, shows the shareable code, and
+    /// auto-joins the game as soon as an opponent accepts it.
+    pub fn start_hosting_lichess_game(&mut self) {
+        let Ok(client) = self.lichess_state.require_client() else {
+            self.ui_state.show_message_popup(
+                "Lichess client not properly initialized, did you configure a lichess token ?"
+                    .to_string(),
+                Popups::Error,
+            );
+            return;
+        };
+        let client = client.clone();
+
+        let idx = usize::from(self.lichess_state.host_game_cursor)
+            .min(crate::constants::LICHESS_HOST_TIME_CONTROLS.len() - 1);
+        let (_, limit_seconds, increment_seconds) =
+            crate::constants::LICHESS_HOST_TIME_CONTROLS[idx];
+
+        let (tx, rx) = channel();
+        self.lichess_state.receiver = Some(rx);
+        self.lichess_state.host_challenge = None;
+
+        let cancellation_token = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        self.lichess_state.cancellation_token = Some(cancellation_token.clone());
+
+        self.ui_state.current_popup = Some(Popups::LichessHostWaiting);
+
+        std::thread::spawn(move || {
+            let challenge = match client.create_open_challenge(limit_seconds, increment_seconds) {
+                Ok(challenge) => challenge,
+                Err(e) => {
+                    let _ = tx.send(LichessUpdate::HostChallengeCreated(Err(e.to_string())));
+                    return;
+                }
+            };
+
+            // The open-challenge endpoint pairs two OTHER players, so this
+            // account must claim one of the two seats before sharing the code.
+            if let Err(e) = client.accept_challenge(&challenge.id, "white") {
+                let _ = client.cancel_challenge(&challenge.id);
+                let _ = tx.send(LichessUpdate::HostGameFailed(format!(
+                    "could not claim a seat in the challenge: {}",
+                    e
+                )));
+                return;
+            }
+
+            let url = challenge
+                .url
+                .clone()
+                .unwrap_or_else(|| format!("https://lichess.org/{}", challenge.id));
+            let _ = tx.send(LichessUpdate::HostChallengeCreated(Ok((
+                challenge.id.clone(),
+                url,
+            ))));
+
+            // Wait for the opponent; auto-join the game as soon as it starts.
+            match client.wait_for_open_challenge_start(&challenge.id, cancellation_token.clone()) {
+                Ok((game_id, color)) => {
+                    let _ = tx.send(LichessUpdate::SeekResult(Ok((game_id, color))));
+                }
+                Err(e) => {
+                    // Withdraw the challenge whether the user cancelled or we
+                    // timed out; only report an error for the latter.
+                    let _ = client.cancel_challenge(&challenge.id);
+                    if !cancellation_token.load(std::sync::atomic::Ordering::Relaxed) {
+                        let _ = tx.send(LichessUpdate::HostGameFailed(e.to_string()));
+                    }
+                }
+            }
+        });
+    }
+
+    /// Cancels hosting: stops the waiting thread (which also withdraws the
+    /// challenge on Lichess) and returns to the Lichess menu.
+    pub fn cancel_lichess_hosting(&mut self) {
+        if let Some(token) = &self.lichess_state.cancellation_token {
+            token.store(true, std::sync::atomic::Ordering::Relaxed);
+        }
+        self.lichess_state.receiver = None;
+        self.lichess_state.cancellation_token = None;
+        self.lichess_state.host_challenge = None;
+        self.ui_state.close_popup();
+        self.ui_state.current_page = Pages::LichessMenu;
+    }
