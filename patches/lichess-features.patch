+//! Puzzle difficulty picker for anonymous (no-token) play.
+
+use crate::{
+    app::App,
+    constants::{LICHESS_PUZZLE_DIFFICULTIES, WHITE},
+    ui::components::centered_rect::centered_rect,
+};
+use ratatui::{
+    Frame,
+    layout::Alignment,
+    style::{Color, Modifier, Style},
+    text::{Line, Span},
+    widgets::{Block, BorderType, Borders, Clear, Padding, Paragraph, Wrap},
+};
+
+/// Renders the difficulty picker shown when playing puzzles without a token.
+pub fn render_puzzle_level_popup(frame: &mut Frame, app: &App) {
+    let block = Block::default()
+        .title("Puzzles (anonymous)")
+        .borders(Borders::ALL)
+        .border_type(BorderType::Rounded)
+        .padding(Padding::horizontal(1))
+        .border_style(Style::default().fg(WHITE));
+    let area = centered_rect(50, 60, frame.area());
+
+    let mut text = vec![
+        Line::from("No Lichess token needed — pick a difficulty:").alignment(Alignment::Center),
+        Line::from(""),
+        Line::from("Levels are relative to a 1500 puzzle rating."),
+        Line::from(""),
+    ];
+
+    for (idx, (label, _)) in LICHESS_PUZZLE_DIFFICULTIES.iter().enumerate() {
+        let selected = idx as u8 == app.lichess_state.puzzle_level_cursor;
+        let style = if selected {
+            Style::default()
+                .fg(Color::Black)
+                .bg(Color::White)
+                .add_modifier(Modifier::BOLD)
+        } else {
+            Style::default().fg(Color::White)
+        };
+        let prefix = if selected { "► " } else { "  " };
+        text.push(Line::from(vec![
+            Span::styled(prefix, style),
+            Span::styled(*label, style),
+        ]));
+    }
+
+    text.push(Line::from(""));
+    text.push(Line::from("↑/↓ Select   Enter Start   Esc Cancel"));
+
+    let paragraph = Paragraph::new(text)
+        .block(block.clone())
+        .alignment(Alignment::Left)
+        .wrap(Wrap { trim: true });
+
+    frame.render_widget(Clear, area);
+    frame.render_widget(block, area);
+    frame.render_widget(paragraph, area);
+}
