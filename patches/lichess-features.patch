+    /// Loads a puzzle for anonymous play at the requested difficulty
+    /// (`easiest`, `easier`, `normal`, `harder`, `hardest`).
+    pub fn load_anonymous(
+        client: &LichessClient,
+        game_board: &mut GameBoard,
+        difficulty: &str,
+    ) -> Result<Puzzle, String> {
+        let puzzle = client
+            .get_next_puzzle_with_difficulty(difficulty)
+            .map_err(|e| e.to_string())?;
+        Self::setup_board(&puzzle, game_board)?;
+        Ok(puzzle)
+    }
