+    /// Create an open challenge with the given clock. A limit of 0 creates a
+    /// correspondence challenge (3 days per move); `rated` selects a rated
+    /// game. The returned challenge can be shared with an opponent; it
+    /// becomes a game once accepted, keeping the same id.
+    pub fn create_open_challenge(
+        &self,
+        limit_seconds: u32,
+        increment_seconds: u32,
+        rated: bool,
+    ) -> Result<OpenChallenge, Box<dyn Error>> {
+        let url = format!("{}/challenge/open", LICHESS_API_URL);
+
+        let mut form: Vec<(&str, String)> = vec![
+            ("rated", if rated { "true" } else { "false" }.to_string()),
+            ("variant", "standard".to_string()),
+        ];
+        if limit_seconds == 0 {
+            form.push(("days", "3".to_string()));
+        } else {
+            form.push(("clock.limit", limit_seconds.to_string()));
+            form.push(("clock.increment", increment_seconds.to_string()));
+        }
+
+        let response = self
+            .client
+            .post(&url)
+            .header(
+                "User-Agent",
+                "chess-tui (https://github.com/thomas-mauran/chess-tui)",
+            )
+            .bearer_auth(&self.token)
+            .form(&form)
+            .send()?;
+
+        let status = response.status();
+        if !status.is_success() {
+            let error_text = response.text().unwrap_or_default();
+            log::error!("Open challenge request failed: {} - {}", status, error_text);
+            if status == reqwest::StatusCode::UNAUTHORIZED {
+                return Err("Invalid token. Please check your token or generate a new one.".into());
+            }
+            if status == reqwest::StatusCode::FORBIDDEN {
+                return Err("Token missing permissions. Please generate a new token with 'board:play' scope enabled.".into());
+            }
+            if status == reqwest::StatusCode::TOO_MANY_REQUESTS {
+                return Err(
+                    "Rate limit exceeded. Please wait a minute before trying again.".into(),
+                );
+            }
+            if status == reqwest::StatusCode::BAD_REQUEST {
+                return Err(format!(
+                    "Lichess rejected the challenge parameters: {}",
+                    error_text
+                )
+                .into());
+            }
+            return Err(format!("Failed to create challenge: {} - {}", status, error_text).into());
+        }
+
+        let challenge: OpenChallenge = response.json()?;
+        log::info!(
+            "Created open challenge: {} ({:?})",
+            challenge.id,
+            challenge.url
+        );
+        Ok(challenge)
+    }
